#!/bin/sh
# 이 작업 폴더에서 기본 작업 가지에 커밋하면 GitHub에도 바로 올려요.
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
if [ "$branch" != "main" ]; then
  printf '\n자동 동기화는 main에서 커밋할 때만 실행해요.\n'
  exit 0
fi

# 저장소 주소가 달라졌다면 다른 곳으로 보내지 않고 멈춰요.
remote=$(git remote get-url --push origin 2>/dev/null)
if [ "$remote" != "https://github.com/gkak00940-netizen/1110.git" ]; then
  printf '\n저장소 주소가 달라 자동 동기화를 멈췄어요.\n'
  exit 0
fi

printf '\nGitHub에 변경 내용을 자동으로 올리고 있어요…\n'
if ! git push origin main; then
  printf '\n커밋은 이 컴퓨터에 저장됐지만 GitHub에 올리지는 못했어요.\n인터넷과 GitHub 로그인을 확인한 뒤 변경 사항 동기화를 눌러 주세요.\n'
fi
# 업로드가 실패해도 이미 만든 커밋은 그대로 남겨 둬요.
exit 0
